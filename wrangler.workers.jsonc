{
  // Workers-flavoured deployment (a plain Worker on a custom domain):
  //   npx wrangler deploy -c wrangler.workers.jsonc
  // with CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in the environment (see
  // scripts/mint-deploy-token.sh). imazen's live instance uses the Pages
  // config in wrangler.jsonc instead; this one is kept for the day the
  // instance moves to a Worker. Adapt `routes` and the vars for your account.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-lfs-s3-proxy",
  "main": "_worker.js",
  "compatibility_date": "2026-08-15",
  "routes": [{ "pattern": "lfs.imazen.org", "custom_domain": true }],
  "vars": {
    // Only sign URLs for these S3 endpoints (hostname or parent-domain suffix,
    // comma-separated). Empty = sign for any endpoint, like upstream.
    "ALLOWED_ENDPOINTS": "338ad3b06716695d6e2c81c864e387d8.r2.cloudflarestorage.com",
    // Locations whose objects are also served from a public bucket domain:
    // downloads requested without credentials get plain URLs there instead of
    // signed S3 URLs, so a public repo commits no key in its .lfsconfig.
    "PUBLIC_DOWNLOAD_BASES": {
      "338ad3b06716695d6e2c81c864e387d8.r2.cloudflarestorage.com/codec-corpus": "https://codec-corpus.r2.imazen.org"
    }
  },
  "observability": { "enabled": true }
}
