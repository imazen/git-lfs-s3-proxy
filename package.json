{
  "name": "git-lfs-s3-proxy",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "aws4fetch": "^1.0.17"
  },
  "scripts": {
    "build": "esbuild _worker.js --bundle --format=esm --outfile=dist/_worker.js --log-level=warning",
    "deploy": "npm run build && wrangler pages deploy --commit-dirty=true",
    "deploy:worker": "wrangler deploy -c wrangler.workers.jsonc",
    "dev": "wrangler dev -c wrangler.workers.jsonc --port 3987"
  },
  "devDependencies": {
    "wrangler": "^4.147.0",
    "esbuild": "^0.25.0"
  }
}
